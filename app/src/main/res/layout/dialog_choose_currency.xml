<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <View
        android:id="@+id/view"
        android:layout_height="match_parent"
        android:layout_width="match_parent"

        android:background="@drawable/rounded_rectangle"
        android:backgroundTint="@color/grey" />

    <ImageButton
        android:id="@+id/dialog_choose_currency_close_button"
        android:layout_width="20dp"
        android:layout_height="25dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:background="@null"
        android:scaleType="fitCenter"

        app:layout_constraintEnd_toEndOf="@+id/view"
        app:layout_constraintTop_toTopOf="@+id/view"
        app:srcCompat="@drawable/close" />

    <TextView
        android:id="@+id/dialog_choose_currency_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="@string/choose_currency"

        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_choose_currency_close_button"
        app:layout_constraintStart_toStartOf="@+id/view"
        app:layout_constraintTop_toTopOf="@+id/dialog_choose_currency_close_button" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/popular_currencies"
        android:textSize="18sp"

        app:layout_constraintStart_toStartOf="@+id/dialog_choose_currency_title"
        app:layout_constraintTop_toBottomOf="@+id/dialog_choose_currency_title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dialog_choose_currency_rv_all_currencies"
        android:layout_width="365dp"
        android:layout_height="605dp"
        android:paddingTop="20dp"

        app:layout_constraintBottom_toBottomOf="@+id/view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />


</androidx.constraintlayout.widget.ConstraintLayout>