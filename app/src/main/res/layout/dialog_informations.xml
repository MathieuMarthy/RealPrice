<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="280sp"
    android:background="@android:color/transparent"
    android:id="@+id/dialog_root">

    <TextView
        android:id="@+id/dialog_informations_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="28dp"

        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/dialog_informations_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/dialog_informations_title"
        app:layout_constraintTop_toBottomOf="@+id/dialog_informations_title"
        app:layout_constraintVertical_bias="0.172" />

    <TextView
        android:id="@+id/dialog_informations_text_allow_mobile_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginBottom="16dp"

        android:labelFor="@+id/settings_bank_taxes_switch_text"
        android:text="@string/allow_data_utilisation"
        app:layout_constraintBottom_toTopOf="@+id/dialog_informations_button"
        app:layout_constraintHorizontal_bias="0.233"
        app:layout_constraintStart_toStartOf="@+id/dialog_informations_text" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/dialog_imnformations_allow_data_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        app:layout_constraintBottom_toBottomOf="@+id/dialog_informations_text_allow_mobile_data"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dialog_informations_text_allow_mobile_data"
        app:layout_constraintTop_toTopOf="@+id/dialog_informations_text_allow_mobile_data" />

    <Button
        android:id="@+id/dialog_informations_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="24dp"

        android:textColor="@color/dark_blue"
        android:backgroundTint="@color/blue"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>